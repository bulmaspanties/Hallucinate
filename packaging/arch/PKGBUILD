# Maintainer: Music Player contributors
pkgname=musicplayer
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, modern desktop music player with Spotify-style search and browsing"
arch=('any')
url="https://example.com/musicplayer"
license=('MIT')
depends=('python' 'pyside6' 'python-mutagen' 'qt6-multimedia-ffmpeg' 'qt6-declarative')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
# Builds from the local checkout (this PKGBUILD lives in packaging/arch).
_src="$startdir/../.."

build() {
  cd "$_src"
  python -m build --wheel --no-isolation --outdir "$srcdir/dist"
}

package() {
  cd "$_src"
  python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
  install -Dm644 packaging/musicplayer.desktop "$pkgdir/usr/share/applications/musicplayer.desktop"
  install -Dm644 musicplayer/assets/musicplayer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/musicplayer.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
