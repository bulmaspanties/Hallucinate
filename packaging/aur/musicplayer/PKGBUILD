# Maintainer: bulmaspanties <https://github.com/bulmaspanties>
pkgname=musicplayer
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, modern desktop music player with Spotify-style search and browsing (PySide6/QML)"
arch=('any')
url="https://github.com/bulmaspanties/music-player"
license=('MIT')
depends=('python' 'pyside6' 'python-mutagen' 'python-keyring' 'qt6-multimedia-ffmpeg' 'qt6-declarative')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('gnome-keyring: store Last.fm credentials in the system keyring'
            'kwallet: store Last.fm credentials in the system keyring')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('384d7190bb2f7b53868f17146472123b5a1fcf760332ba4a5b1f6b62df61fc57')

build() {
  cd "music-player-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "music-player-$pkgver"
  python -c "import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]" musicplayer/*.py musicplayer/core/*.py
}

package() {
  cd "music-player-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/musicplayer.desktop "$pkgdir/usr/share/applications/musicplayer.desktop"
  install -Dm644 musicplayer/assets/musicplayer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/musicplayer.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
