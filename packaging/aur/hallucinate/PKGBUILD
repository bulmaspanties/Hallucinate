# Maintainer: bulmaspanties <https://github.com/bulmaspanties>
pkgname=hallucinate
pkgver=0.3.1
pkgrel=1
pkgdesc="Fast, modern desktop music player with Spotify-style search and browsing (PySide6/QML)"
arch=('any')
url="https://github.com/bulmaspanties/Hallucinate"
license=('MIT')
depends=('python' 'pyside6' 'python-mutagen' 'python-keyring' 'python-numpy' 'qt6-multimedia-ffmpeg' 'qt6-declarative')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('gnome-keyring: store Last.fm credentials in the system keyring'
            'kwallet: store Last.fm credentials in the system keyring')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a3aa76f0b7122d8ec722a159e41748f7dfc85d5a376fe948a60f66aa88a03540')

build() {
  cd "Hallucinate-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "Hallucinate-$pkgver"
  python -c "import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]" hallucinate/*.py hallucinate/core/*.py
}

package() {
  cd "Hallucinate-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/hallucinate.desktop "$pkgdir/usr/share/applications/hallucinate.desktop"
  for s in 16 24 32 48 64 128 256 512; do install -Dm644 "packaging/icons/hicolor/${s}x${s}/apps/hallucinate.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/hallucinate.png"; done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
